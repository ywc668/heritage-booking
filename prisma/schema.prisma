// Heritage Optometry booking system — data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ---------- Auth.js models ----------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          Role      @default(CUSTOMER)
  passwordHash  String?   // only used for admin email/password login
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  appointments Appointment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Business models ----------
model Settings {
  id                Int    @id @default(1)
  businessName      String @default("Heritage")
  timezone          String @default("Australia/Sydney")
  cancelCutoffHours Int    @default(24)  // customers may reschedule/cancel up to N hours before
  bookingWindowDays Int    @default(60)  // how far ahead customers can book
  minNoticeMinutes  Int    @default(60)  // earliest a slot can be booked relative to now
}

model Provider {
  id            String  @id @default(cuid())
  name          String
  title         String  @default("Optometrist")
  email         String?
  active        Boolean @default(true)
  slotMinutes   Int     @default(20)
  bufferMinutes Int     @default(0)
  sortOrder     Int     @default(0)
  createdAt     DateTime @default(now())

  workingHours WorkingHours[]
  timeOff      TimeOff[]
  appointments Appointment[]
}

// One row per weekday (0 = Sunday … 6 = Saturday). Minutes since local midnight.
model WorkingHours {
  id           String  @id @default(cuid())
  providerId   String
  weekday      Int
  startMinutes Int
  endMinutes   Int
  enabled      Boolean @default(true)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, weekday])
}

model TimeOff {
  id         String   @id @default(cuid())
  providerId String
  startsAt   DateTime
  endsAt     DateTime
  reason     String?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startsAt])
}

model Appointment {
  id          String            @id @default(cuid())
  userId      String
  providerId  String
  startsAt    DateTime
  endsAt      DateTime
  status      AppointmentStatus @default(BOOKED)
  notes       String?           // customer note
  adminNotes  String?           // internal note
  cancelledAt DateTime?
  cancelledBy String?           // "customer" | "admin"
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId, startsAt])
  @@index([userId, startsAt])
}
